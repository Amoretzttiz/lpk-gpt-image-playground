FROM node:20-alpine
WORKDIR /app
RUN apk add --no-cache util-linux
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server ./server
ENV HOST=0.0.0.0
ENV PORT=8787
ENV PERSISTENCE_DIR=/lzcapp/var/gpt-image-playground
ENV BACKUP_DIR=/lzcapp/var/gpt-image-playground/backups
VOLUME ["/lzcapp/var"]
EXPOSE 8787
CMD ["node", "server/persistence.mjs"]
