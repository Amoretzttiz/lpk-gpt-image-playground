{
  "manifest_version": 1,
  "name": "GPT Image Playground",
  "package_name": "gpt-image-playground",
  "version": "0.7.9",
  "description": "GPT Image Playground with persistent local storage",
  "entrypoint": ["node", "server/persistence.mjs"],
